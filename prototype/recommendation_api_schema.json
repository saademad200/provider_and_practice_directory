{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderDirectoryRecommendationBatch",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_version",
    "metrics_snapshot",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "const": "provider-directory-recommendation-v1"
    },
    "pipeline_version": {
      "type": "string"
    },
    "metrics_snapshot": {
      "type": "object"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider_id",
          "npi",
          "change_detected",
          "changes",
          "overall_confidence",
          "recommended_action",
          "reason",
          "audit_required"
        ],
        "properties": {
          "provider_id": {
            "type": "string"
          },
          "provider_name": {
            "type": "string"
          },
          "npi": {
            "type": "string"
          },
          "practice_id": {
            "type": "string"
          },
          "change_detected": {
            "type": "boolean"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "old_value",
                "new_value",
                "confidence_score",
                "supporting_sources",
                "source_observations",
                "field_decision",
                "field_risk",
                "launch_state",
                "policy_version",
                "evidence_hash",
                "rollback_eligible"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "old_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "new_value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "confidence_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "supporting_sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "source_observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "source",
                      "url",
                      "authority_tier"
                    ],
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "authority_tier": {
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      },
                      "age_days": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "freshness_status": {
                  "type": "string"
                },
                "field_decision": {
                  "enum": [
                    "auto_apply",
                    "review"
                  ]
                },
                "field_risk": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "launch_state": {
                  "enum": [
                    "auto_update_candidate",
                    "review_only",
                    "blocked",
                    "no_change_confirmed"
                  ]
                },
                "policy_version": {
                  "type": "string"
                },
                "review_reason_code": {
                  "type": "string"
                },
                "review_priority_score": {
                  "type": "number"
                },
                "audit_event_type": {
                  "type": "string"
                },
                "evidence_hash": {
                  "type": "string"
                },
                "rollback_eligible": {
                  "type": "boolean"
                }
              }
            }
          },
          "overall_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recommended_action": {
            "enum": [
              "auto_update",
              "human_review",
              "no_change"
            ]
          },
          "reason": {
            "type": "string"
          },
          "supporting_source_count": {
            "type": "integer",
            "minimum": 0
          },
          "audit_required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
