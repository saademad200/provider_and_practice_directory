{
  "contract_version": "2026-06-16",
  "name": "provider_directory_review_disposition",
  "properties": {
    "audit_event_id": {
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable hash or UUID for the candidate update row.",
      "type": "string"
    },
    "disposition_reason": {
      "type": "string"
    },
    "field": {
      "enum": [
        "phone",
        "address",
        "specialty",
        "license_status",
        "accepting_new_patients"
      ]
    },
    "old_value": {
      "type": "string"
    },
    "practice_id": {
      "type": "string"
    },
    "proposed_value": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "review_action": {
      "enum": [
        "accept",
        "reject",
        "edit",
        "defer",
        "request_recrawl"
      ]
    },
    "reviewed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reviewer_id": {
      "description": "Authenticated reviewer identity, not a free-text name.",
      "type": "string"
    },
    "reviewer_value": {
      "description": "Required when review_action is edit.",
      "type": "string"
    },
    "sla_status": {
      "enum": [
        "within_sla",
        "breached",
        "paused_waiting_on_source"
      ]
    },
    "source_feedback": {
      "enum": [
        "source_correct",
        "source_wrong",
        "source_stale",
        "source_insufficient",
        "not_applicable"
      ]
    },
    "source_run_id": {
      "type": "string"
    }
  },
  "required_fields": [
    "candidate_id",
    "provider_id",
    "field",
    "reviewer_id",
    "review_action",
    "reviewed_at",
    "disposition_reason",
    "audit_event_id"
  ],
  "validation_rules": [
    "reviewer_id must come from authenticated AWS Cognito or workforce identity provider context",
    "edit requires reviewer_value and disposition_reason",
    "request_recrawl requires at least one stale or insufficient source reason",
    "accept/reject/edit must write an append-only audit event before downstream mutation",
    "identity-level or inactive-provider decisions require elevated reviewer role"
  ]
}